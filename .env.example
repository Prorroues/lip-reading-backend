# ===== Dify 大模型工作流（可选模块：语义纠错）=====
# 不配则 /llm_interaction 不可用，唇语识别主功能不受影响
base_url=你的Dify服务器地址（不含端口）
dify_port=21000
api_key=你的Dify-API-Key
app_user=default-user

# ===== 可选：其他大模型 Key =====
DASHSCOPE_API_KEY=
SILICON_FLOW_API_KEY=

# ===== MiVOLO 年龄性别估计（可选模块）=====
# 下载方法见 docs/models.md
FACE_ESTIMATE_PATH=MiVOLO/models/mivolo_imbd.pth.tar
FACE_DETECTOR_PATH=MiVOLO/models/yolov8x_person_face.pt

# ===== 可选：服务调优参数（2026-10-05 优化新增，均有默认值，不配也能跑）=====
# BACKEND_API_KEY=        # 设置后所有敏感接口要求请求头 X-API-Key，不设则无鉴权（勿暴露公网）
# MAX_UPLOAD_MB=200       # 上传视频大小上限（MB）
# RETENTION_DAYS=3        # uploads/generates 文件保留天数，过期自动清理
# TASK_TTL_SECONDS=3600   # 已完成识别任务的结果保留时长（秒）
# TASK_TIMEOUT_SECONDS=600 # 识别任务超时判失败（秒）
# INFERENCE_CONCURRENCY=1 # 推理并发度，GPU/NPU 建议保持 1
# DEBUG=0                 # 置 1 后 500 响应携带 traceback（仅调试用）
# HOST=0.0.0.0            # 监听地址
# PORT=24060              # 监听端口